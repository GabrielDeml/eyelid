<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for Contents/Library/LaunchDaemons/com.gdeml.Eyelid.helper.plist.
     scripts/build.sh fills in the Team ID and the signed helper's cdhash, then signs the app, which seals this file.
     Ad-hoc builds get no daemon plist. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.gdeml.Eyelid.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/EyelidHelper</string>
	<key>MachServices</key>
	<dict>
		<key>com.gdeml.Eyelid.helper</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.gdeml.Eyelid</string>
	</array>
	<key>SpawnConstraint</key>
	<dict>
		<key>team-identifier</key>
		<string>__TEAM_ID__</string>
		<key>signing-identifier</key>
		<string>com.gdeml.Eyelid.helper</string>
		<key>cdhash</key>
		<dict>
			<key>$in</key>
			<array>
				<data>__HELPER_CDHASH_BASE64__</data>
			</array>
		</dict>
	</dict>
</dict>
</plist>
