#!/bin/bash
# Runs as root before Installer copies Eyelid.app into /Applications (docs/RELEASE.md, "What the installer does").
# Installer passes $1 = package path, $2 = install location, $3 = target volume. The distribution file only allows the
# startup disk, so the paths below are absolute.
#   1. Refuse to install while a build from before the rename (Insomnia) is still in /Applications. The
#      distribution's installation check already does this, with a proper message, for installs from the Installer
#      app and `installer -pkg`; this repeats it for anything that bypasses the distribution. Its message only reaches
#      /var/log/install.log.
#   2. Quit every running copy with quit-running.sh, shipped next to this script. Its quit releases lid mode first.
#   3. Remove what the first version's ad-hoc setup left behind, as `make install` does.
#   4. Leave notes for postinstall in $INSTALLER_TEMP: the logged-in user's uid if they had a copy running, and the
#      cdhash of the helper launchd is running, if that is still the one on disk.
# Any non-zero exit stops the install before anything is copied, so only steps 1 and 2 may fail it.
set -euo pipefail

APP=/Applications/Eyelid.app
PRERENAME_APP=/Applications/Insomnia.app
PRERENAME_ID=com.gdeml.Insomnia
WAS_RUNNING=com.gdeml.Eyelid.was-running
OLD_HELPER=com.gdeml.Eyelid.old-helper-cdhash
NOTES=""
if [[ -n "${INSTALLER_TEMP:-}" && -d "$INSTALLER_TEMP" ]]; then NOTES=$INSTALLER_TEMP; fi

# 1. Only exactly the old bundle ID counts: any other app named Insomnia is someone else's. The old copy's lid helper
#    is registered to that bundle and only its own --unregister-helper, run by the user who registered it, removes
#    it, so root can't clean it up here. PlistBuddy prints "File Doesn't Exist" on stdout when there's no Info.plist,
#    so only its success counts.
if [[ -e "$PRERENAME_APP" ]]; then
    id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$PRERENAME_APP/Contents/Info.plist" 2>/dev/null) \
        || id=""
    if [[ "$id" == "$PRERENAME_ID" ]]; then
        echo "A pre-release build named Insomnia is installed. Remove it, then install again:" \
            "$PRERENAME_APP/Contents/MacOS/Insomnia --unregister-helper; sudo rm -rf $PRERENAME_APP" >&2
        exit 1
    fi
fi

# 2. Whether the logged-in user has a copy open (only theirs is reopened; other users' copies are quit too), judged
#    by the executable the kernel has mapped, as quit-running.sh does as root. quit-running.sh's test hooks must never
#    redirect it during a real install.
console_uid=$(/usr/bin/stat -f %u /dev/console 2>/dev/null) || console_uid=""
console_had_copy=0
if [[ -n "$console_uid" && "$console_uid" != 0 ]]; then
    for pid in $(/usr/sbin/lsof -a -d txt -t -- "$APP/Contents/MacOS/Eyelid" 2>/dev/null); do
        uid=$(/bin/ps -o uid= -p "$pid" 2>/dev/null) || continue
        if [[ "${uid// /}" == "$console_uid" ]]; then console_had_copy=1; fi
    done
fi
unset EYELID_QUIT_TEST_ID EYELID_QUIT_TEST_PATTERN
q=0
"$(dirname "$0")/quit-running.sh" 10 || q=$?
case $q in
    0|3) ;;
    *)  echo "Couldn't quit Eyelid (quit-running.sh exit $q), so nothing was installed. Quit it from its panel," \
            "then install again." >&2
        exit 1 ;;
esac

# 3. The first version's passwordless sudoers rule for `pmset -a disablesleep 0|1` and its root safety daemon
#    (docs/DESIGN.md "Security", v1 leftovers): exactly what the Makefile's REMOVE_LEGACY removes. The quit above
#    reached only Eyelid (as root a process counts by its path alone, so a first-version copy can't be told from
#    someone else's app), so a first-version app still running loses its rule and the SleepDisabled hint below is the
#    fallback. A cleanup that fails must not fail the install, so every step ends in `|| true`. ioreg's output is
#    captured before matching: a pipe into `grep -q` can die of SIGPIPE under pipefail.
LEGACY_SUDOERS=/etc/sudoers.d/zz_insomnia
LEGACY_DAEMON=/Library/LaunchDaemons/com.gdeml.insomnia.safety.plist
if [[ -e "$LEGACY_SUDOERS" || -e "$LEGACY_DAEMON" ]]; then
    echo "Removing the old version's passwordless pmset rule and safety daemon" || true
    /bin/launchctl bootout system/com.gdeml.insomnia.safety 2>/dev/null || true
    /bin/rm -f "$LEGACY_SUDOERS" "$LEGACY_DAEMON" /etc/sudoers.d/.insomnia.* /Library/LaunchDaemons/.insomnia.* \
        /var/run/com.gdeml.insomnia.booted 2>/dev/null || true
    /bin/rm -rf /private/var/root/insomnia.* 2>/dev/null || true
    rd=$(/usr/sbin/ioreg -r -c IOPMrootDomain -d 1 2>/dev/null) || rd=""
    if [[ "$rd" != *'"SleepDisabled" = No'* && ! -e /var/run/com.gdeml.Eyelid.helper.engaged ]]; then
        echo "Your Mac still can't sleep (SleepDisabled is set, not by the lid helper). If no other app should be" \
            "holding it, run: sudo pmset -a disablesleep 0" || true
    fi
fi

# 4. Missing notes only mean postinstall neither reopens Eyelid nor restarts the helper (the app then sets the helper
#    up again when it next opens). The marker holds the console uid, so postinstall can tell whether the same user is
#    still at the console. The helper's cdhash is noted only while the running helper is still the code on
#    disk (`codesign -v <pid>` fails otherwise): after an update that was never followed by opening Eyelid, launchd
#    runs and pins an older helper than the one in the bundle, and restarting would start code its pin rejects.
if [[ -n "$NOTES" ]]; then
    if (( q == 3 && console_had_copy )); then printf '%s\n' "$console_uid" > "$NOTES/$WAS_RUNNING" || true; fi
    helper_pid=$(/bin/launchctl print system/com.gdeml.Eyelid.helper 2>/dev/null \
        | /usr/bin/sed -n 's/^[[:space:]]*pid = \([0-9][0-9]*\)$/\1/p') || helper_pid=""
    if [[ -n "$helper_pid" && -f "$APP/Contents/MacOS/EyelidHelper" ]] \
        && /usr/bin/codesign -v "$helper_pid" >/dev/null 2>&1; then
        { /usr/bin/codesign -dvvv "$APP/Contents/MacOS/EyelidHelper" 2>&1 | /usr/bin/sed -n 's/^CDHash=//p' \
            > "$NOTES/$OLD_HELPER"; } || true
    fi
fi
exit 0
