<?xml version="1.0" encoding="utf-8"?>
<!-- The installer's distribution file (docs/RELEASE.md, "What the installer does"). scripts/release.sh fills in the
     version and the component package's file name, then passes the result to productbuild. -->
<installer-gui-script minSpecVersion="2">
    <title>Eyelid</title>
    <options customize="never" require-scripts="true" hostArchitectures="arm64"/>
    <!-- Startup disk only: lid mode needs a root-owned /Applications/Eyelid.app. -->
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="14.0"/>
        </allowed-os-versions>
    </volume-check>
    <!-- Runs for the Installer app and for `installer -pkg`, before anything is copied. It stops when:
         - a build from before the rename is installed (/Applications/Insomnia.app with bundle ID exactly
           com.gdeml.Insomnia). Its lid helper is registered to that bundle, and only that app's own unregister
           command, run by the user who registered it, can remove it, so the user does that first. Any other app
           named Insomnia is someone else's and doesn't matter.
         - a newer Eyelid is installed: Installer would skip the app but still run the scripts and record the older
           version.
         preinstall repeats the first check for installs that bypass this file. -->
    <installation-check script="checkInstalledEyelid()"/>
    <script><![CDATA[
function checkInstalledEyelid() {
    var old = system.files.bundleAtPath("/Applications/Insomnia.app");
    if (old && old.CFBundleIdentifier == "com.gdeml.Insomnia") {
        system.log("Eyelid: /Applications/Insomnia.app is a pre-release build (com.gdeml.Insomnia)");
        my.result.type = "Fatal";
        my.result.title = "A pre-release build named Insomnia is installed";
        my.result.message = "Before its first release this app was called Insomnia, and that build is still in " +
            "your Applications folder. Remove it by running these two commands in Terminal, then open this " +
            "installer again:\n\n" +
            "/Applications/Insomnia.app/Contents/MacOS/Insomnia --unregister-helper\n" +
            "sudo rm -rf /Applications/Insomnia.app";
        return false;
    }
    var bundle = system.files.bundleAtPath("/Applications/Eyelid.app");
    if (!bundle || bundle.CFBundleIdentifier != "com.gdeml.Eyelid") {
        return true;
    }
    var installed = bundle.CFBundleShortVersionString;
    if (installed && system.compareVersions(installed, "__VERSION__") > 0) {
        system.log("Eyelid: " + installed + " is installed, this package is __VERSION__");
        my.result.type = "Fatal";
        my.result.title = "A newer Eyelid is installed";
        my.result.message = "Eyelid " + installed + " is already installed. To go back to __VERSION__, " +
            "uninstall Eyelid first (see the README), then open this installer again.";
        return false;
    }
    return true;
}
    ]]></script>
    <pkg-ref id="com.gdeml.Eyelid.pkg"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.gdeml.Eyelid.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.gdeml.Eyelid.pkg" visible="false">
        <pkg-ref id="com.gdeml.Eyelid.pkg"/>
    </choice>
    <pkg-ref id="com.gdeml.Eyelid.pkg" version="__VERSION__" onConclusion="none">__COMPONENT_PKG__</pkg-ref>
</installer-gui-script>
